{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "RabbitMq": "amqp://mediaforge:mediaforge_dev@localhost:5672"
  },
  "IdentityServer": {
    "Authority": "http://localhost:5001"
  },
  "HealthChecks": {
    "IdentityApiUrl": "http://localhost:5001/health/live",
    "MediaApiUrl": "http://localhost:5002/health/live",
    "CatalogApiUrl": "http://localhost:5005/health/live",
    "LibraryApiUrl": "http://localhost:5006/health/live"
  },
  "RabbitMq": {
    "Username": "mediaforge",
    "Password": "mediaforge_dev"
  },
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "friends-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/friends/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "notifications-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "authors-follow-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/authors/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "media-upload-route": {
        "ClusterId": "media-cluster",
        "Match": { "Path": "/api/media/upload-url" },
        "RateLimiterPolicy": "upload"
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": { "Path": "/api/media/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "search-works-route": {
        "ClusterId": "search-cluster",
        "Match": { "Path": "/api/search/works" },
        "RateLimiterPolicy": "general"
      },
      "search-persons-route": {
        "ClusterId": "search-cluster",
        "Match": { "Path": "/api/search/persons" },
        "RateLimiterPolicy": "general"
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": { "Path": "/api/search/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "persons-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/persons/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "genres-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/genres/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "series-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/series/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "works-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/works/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "parts-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/parts/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "editions-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/editions/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "work-requests-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/work-requests/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "channel-rss-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/channels/{channelId}/rss" },
        "RateLimiterPolicy": "general"
      },
      "channels-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/channels/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "library-route": {
        "ClusterId": "library-cluster",
        "Match": { "Path": "/api/library/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "progress-route": {
        "ClusterId": "library-cluster",
        "Match": { "Path": "/api/progress/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "lists-route": {
        "ClusterId": "library-cluster",
        "Match": { "Path": "/api/lists/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "reviews-route": {
        "ClusterId": "library-cluster",
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "reactions-route": {
        "ClusterId": "library-cluster",
        "Match": { "Path": "/api/reactions/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "reports-route": {
        "ClusterId": "library-cluster",
        "Match": { "Path": "/api/reports/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "work-reviews-route": {
        "ClusterId": "library-cluster",
        "Match": { "Path": "/api/works/{workId}/reviews" },
        "RateLimiterPolicy": "general"
      },
      "health-identity": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/health/identity" }
      },
      "health-media": {
        "ClusterId": "media-cluster",
        "Match": { "Path": "/health/media" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": { "Address": "http://localhost:5001" }
        }
      },
      "media-cluster": {
        "Destinations": {
          "media-api": { "Address": "http://localhost:5002" }
        }
      },
      "search-cluster": {
        "Destinations": {
          "search-api": { "Address": "http://localhost:5003" }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": { "Address": "http://localhost:5005" }
        }
      },
      "library-cluster": {
        "Destinations": {
          "library-api": { "Address": "http://localhost:5006" }
        }
      }
    }
  }
}
