{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "RabbitMq": "amqp://mediaforge:mediaforge_dev@localhost:5672"
  },
  "IdentityServer": {
    "Authority": "http://localhost:5001"
  },
  "RabbitMq": {
    "Username": "mediaforge",
    "Password": "mediaforge_dev"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "media-upload-route": {
        "ClusterId": "media-cluster",
        "Match": { "Path": "/api/media/upload-url" },
        "RateLimiterPolicy": "upload"
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": { "Path": "/api/media/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": { "Path": "/api/search/{**catch-all}" },
        "RateLimiterPolicy": "general"
      },
      "health-identity": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/health/identity" }
      },
      "health-media": {
        "ClusterId": "media-cluster",
        "Match": { "Path": "/health/media" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": { "Address": "http://localhost:5001" }
        }
      },
      "media-cluster": {
        "Destinations": {
          "media-api": { "Address": "http://localhost:5002" }
        }
      },
      "search-cluster": {
        "Destinations": {
          "search-api": { "Address": "http://localhost:5003" }
        }
      }
    }
  }
}
