meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "test_verify2@mediaforge.dev",
    "password": "Password1!"
  }
  
  // test_verify2@mediaforge.dev
  // test2@mediaforge.dev
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.accessToken);
    bru.setVar("refreshToken", res.body.refreshToken);
    console.log("Token saved:", res.body.accessToken.substring(0, 30) + "...");
  }
}
